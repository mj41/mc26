// {{.VarName}} holds the {{.Name}} constant names of the play state, indexed
// by id; ids of the other states overlap with these and print through the same
// table.
var {{.VarName}} = [...]string{
{{- range .Names}}
	{{printf "%q" .}},
{{- end}}
